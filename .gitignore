.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Logs
*.log

# Temporary files
*.tmp

# Build tools (not deployed)
node_modules/
.fonts/
.netlify/

# Claude Code : la config d'equipe est versionnee (elle suit le projet sur
# tous les postes), les fichiers personnels et locaux restent hors git.
.claude/*
!.claude/settings.json
.claude/settings.local.json

# Documents et exports locaux (ne pas versionner)
*.pdf
qr-code.*
gamedoor41.fr-Performance-on-Search-*/
*.xlsx
*.csv
!data/*.csv

